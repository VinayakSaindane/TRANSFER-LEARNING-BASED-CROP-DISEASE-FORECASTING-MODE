# AgriGuard AI Environment Configuration
# Copy this file to .env if you want to override defaults. No paid API keys are required.

# Deep learning backend: "torch" (default when TensorFlow is absent) or "tensorflow"
# KERAS_BACKEND=torch

# Request timeouts & cache TTLs
AGRIGUARD_API_TIMEOUT=12
AGRIGUARD_WEATHER_CACHE_MINUTES=30
AGRIGUARD_CLIMATE_CACHE_HOURS=12

# Default location (Nashik, Maharashtra, India)
AGRIGUARD_DEFAULT_CITY=Nashik
AGRIGUARD_DEFAULT_LAT=19.9975
AGRIGUARD_DEFAULT_LON=73.7898

